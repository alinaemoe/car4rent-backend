# Database
DB_HOST=127.0.0.1
DB_PORT=5434
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=car4rent
PORT=3000
DB_SYNC=true
DB_MIGRATIONS_RUN=false

# Auth (generate long random strings, e.g. openssl rand -hex 32)
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too

# Cloudinary (Dashboard -> API Keys)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Mail (Gmail: use an app password, not the account password)
MAIL_USER=your-account@gmail.com
MAIL_PASS=your-app-password
MAIL_FROM=no-reply@example.com

# Optional: accepted instead of the emailed OTP. Demo only - leave empty in production.
DEMO_MASTER_OTP=
