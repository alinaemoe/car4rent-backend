{
  "compilerOptions": {
    // 1. Убираем ругань на депрекацию (важно: "5.0" или "6.0")
    "ignoreDeprecations": "5.0",

    // 2. Оставляем возможность писать от корня
    "baseUrl": ".",
    "paths": {
      "src/*": ["src/*"]
    },

    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "ES2023",
    "outDir": "./dist",

    // 3. Твой любимый режим "без занудства"
    "strict": false,
    "strictPropertyInitialization": false,
    "strictNullChecks": false,
    "noImplicitAny": false,

    // 4. Обязательно для NestJS и TypeORM
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "exclude": ["node_modules", "dist"]
}
